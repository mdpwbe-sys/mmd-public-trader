# EVE Online OAuth2 application credentials
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
CALLBACK_URL=http://127.0.0.1:8766/callback

# ESI requires an identifiable User-Agent with a contact address.
ESI_USER_AGENT=EVE-Market-Manager/0.1 (contact:you@example.com)
# Optional compatibility date. Uncomment only with a valid YYYY-MM-DD value.
# ESI_VERSION_DATE=YYYY-MM-DD

# Optional trading locations. Leave unset to configure them from your own data.
# Sell_Station_ID=your_sell_station_id
# Sell_Station_NAME=Your sell station
# Trading_Upwell_ID=your_structure_id_here
# Trading_Upwell_NAME=your_structure_name_here
